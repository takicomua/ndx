# ── Google Search Console (обов’язково після деплою) ─────────
# 1) https://search.google.com/search-console → Add property → URL prefix
#    https://ndx.com.ua
# 2) Оберіть спосіб підтвердження:
#
#    A) Meta-тег (рекомендовано)
#       Скопіюйте content="..." з інструкції GSC → сюди:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
#
#    B) HTML-файл
#       Якщо GSC дав файл googleXXXX.html — токен (XXXX або повна назва):
GOOGLE_HTML_VERIFICATION=
#       Після деплою відкриється:
#       https://ndx.com.ua/google{TOKEN}.html
#
#    C) DNS TXT — у реєстратора домену (не env):
#       google-site-verification=...
#
# 3) Після Verify → Sitemaps → додайте:
#    https://ndx.com.ua/sitemap.xml
# 4) URL Inspection → головна + /poslugy/* → Request indexing
# 5) Settings → Users: за бажанням додайте GA4 property link

# ── Bing / Yandex (опційно) ───────────────────────────────────
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ── Analytics ─────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# ── Контакти (E-E-A-T / schema sameAs) ────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_TELEGRAM=https://t.me/ndxcom
NEXT_PUBLIC_CONTACT_GITHUB=
NEXT_PUBLIC_CONTACT_LINKEDIN=

# ── Indexing controls ─────────────────────────────────────────
# Force noindex (staging). Production Vercel preview is auto-noindex.
NEXT_PUBLIC_NOINDEX=0

# IndexNow (Bing etc.) — POST/GET /api/indexnow with Bearer token
# Vercel Cron uses CRON_SECRET automatically (vercel.json → weekly ping)
INDEXNOW_SECRET=
CRON_SECRET=
INDEXNOW_KEY=ndx-seo-7c4e9a2f1b8d4063

# ── Lead form → Telegram (@ndxcom) ────────────────────────────
# 1) @BotFather → /newbot → скопіюй токен сюди:
TELEGRAM_BOT_TOKEN=
# 2) З акаунта @ndxcom відкрий бота → Start
#    (якщо це канал @ndxcom — додай бота адміном з правом постингу)
# 3) npm run telegram:chat-id -- <BOT_TOKEN>
#    і встав числовий id сюди:
TELEGRAM_CHAT_ID=
# Альтернатива для публічного каналу: TELEGRAM_CHAT_ID=@ndxcom

RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# ── DNS checklist (registrar — not env) ───────────────────────
# CAA, SPF, DKIM, DMARC — see /.well-known/security-dns.txt after deploy
