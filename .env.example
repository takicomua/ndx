# ── Google Search Console (обов’язково після деплою) ─────────
# 1) https://search.google.com/search-console → Add property → URL prefix
#    https://ndx.com.ua
# 2) Оберіть спосіб підтвердження:
#
#    A) Meta-тег (рекомендовано)
#       Скопіюйте content="..." з інструкції GSC → сюди:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
#
#    B) HTML-файл
#       Якщо GSC дав файл googleXXXX.html — токен (XXXX або повна назва):
GOOGLE_HTML_VERIFICATION=
#       Після деплою відкриється:
#       https://ndx.com.ua/google{TOKEN}.html
#
#    C) DNS TXT — у реєстратора домену (не env):
#       google-site-verification=...
#
# 3) Після Verify → Sitemaps → додайте:
#    https://ndx.com.ua/sitemap.xml
# 4) URL Inspection → головна + /poslugy/* + /blog/* → Request indexing
# 5) Settings → Users: за бажанням додайте GA4 property link
# 6) Performance → Pages: дивіться, які URL світяться (очікуйте 2–6 тижнів)

# ── Bing / Yandex (опційно) ───────────────────────────────────
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ── Analytics ─────────────────────────────────────────────────
# GA4: Admin → Data streams → Measurement ID (G-…)
# Conversion: Admin → Events → mark `generate_lead` as key event
# (форма /zayavka шле dataLayer + gtag event generate_lead)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# ── Google Business Profile (поза кодом, обов’язково для локалки) ─
# 1) https://business.google.com → створити профіль
#    Категорія: Web designer / Software company (або близька)
#    Назва: NDX · DIACHENKO (або як у реєстрації)
#    Регіон: Київ / Україна · service-area business (якщо без вітрини)
# 2) Додати сайт https://ndx.com.ua, телефон/Telegram, години
# 3) Попросити 3–5 клієнтів залишити відгук
# 4) У постах GBP інколи лінкувати /poslugy/* і /blog/*

# ── NAP для LocalBusiness JSON-LD (лише реальні значення) ─────
# Порожнє = поле НЕ потрапляє в schema. Не вигадувати телефон / вулицю.
# TODO: заповнити, коли буде публічний номер / адреса вітрини.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_STREET=
# Координати лише для реального офісу (не «центр Києва навмання»)
NEXT_PUBLIC_BUSINESS_LAT=
NEXT_PUBLIC_BUSINESS_LNG=

# ── Контакти (E-E-A-T / schema sameAs) ────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_TELEGRAM=https://t.me/ndxcom
NEXT_PUBLIC_CONTACT_GITHUB=
NEXT_PUBLIC_CONTACT_LINKEDIN=
# Повний URL профілю DOU, лише якщо існує (не вигадувати):
# NEXT_PUBLIC_CONTACT_DOU=https://dou.ua/users/...
NEXT_PUBLIC_CONTACT_DOU=

# ── Indexing controls ─────────────────────────────────────────
# Force noindex (staging). Production Vercel preview is auto-noindex.
NEXT_PUBLIC_NOINDEX=0

# IndexNow (Bing etc.) — POST/GET /api/indexnow with Bearer token
# Vercel Cron uses CRON_SECRET automatically (vercel.json → weekly ping)
# One-shot after deploy (no secrets; key is public in /ndx-seo-*.txt):
#   npm run indexnow:ping
#   npm run indexnow:ping -- --dry-run
INDEXNOW_SECRET=
CRON_SECRET=
INDEXNOW_KEY=ndx-seo-7c4e9a2f1b8d4063

# ── Lead form → Telegram (@ndxcom) ────────────────────────────
# 1) @BotFather → /newbot → скопіюй токен сюди:
TELEGRAM_BOT_TOKEN=
# 2) З акаунта @ndxcom відкрий бота → Start
#    (якщо це канал @ndxcom — додай бота адміном з правом постингу)
# 3) npm run telegram:chat-id -- <BOT_TOKEN>
#    і встав числовий id сюди:
TELEGRAM_CHAT_ID=
# Альтернатива для публічного каналу: TELEGRAM_CHAT_ID=@ndxcom

RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# ── DNS checklist (registrar — not env) ───────────────────────
# CAA, SPF, DKIM, DMARC — see /.well-known/security-dns.txt after deploy
