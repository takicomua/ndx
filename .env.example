# ── Google Search Console (після деплою — головний безкоштовний крок) ──
# 1) https://search.google.com/search-console → Add property → URL prefix
#    https://ndx.com.ua
# 2) Підтвердження:
#
#    A) Meta-тег (рекомендовано)
#       Скопіюйте content="..." з інструкції GSC → сюди:
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
#
#    B) HTML-файл
#       Якщо GSC дав файл googleXXXX.html — токен (XXXX або повна назва):
GOOGLE_HTML_VERIFICATION=
#       Після деплою: https://ndx.com.ua/google{TOKEN}.html
#
#    C) DNS TXT — у реєстратора домену (не env):
#       google-site-verification=...
#
# 3) Verify → Sitemaps → додайте https://ndx.com.ua/sitemap.xml
# 4) URL Inspection → головна, /poslugy, /poslugy/sajty-ta-lendingy,
#    /poslugy/internet-magazyny, /keysy, /brief → Request indexing
# 5) За бажанням: Google Business Profile (Київ / remote UA) — не env

# ── Bing / Yandex (опційно) ───────────────────────────────────
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ── Analytics (опційно; органіка не залежить від цього) ───────
# GA4 Measurement ID, напр. G-XXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Якщо керуєте тегами в GTM — заповніть лише це і залиште Ads/Pixel порожніми:
NEXT_PUBLIC_GTM_ID=

# Google Ads Search test (код уже вміє conversion; IDs — лише після логіну в Ads)
# 1) Google Ads → Goals → Conversions → New → Website → Submit lead form
#    Event: generate_lead / gtag event `conversion`
# 2) Tag setup → use Google tag (gtag.js). Copy:
#    Conversion ID  → NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789
#    Conversion label → NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=AbCdEfGhIjk
#    (або повний send_to одним рядком)
# 3) Redeploy Vercel with those env vars. Leave empty until the conversion action exists.
# 4) Search landings: /poslugy/sajty-ta-lendingy, /poslugy/internet-magazyny,
#    /keysy/lending-pid-reklamu, /brief
# If you use GTM instead, set only NEXT_PUBLIC_GTM_ID and fire Ads conversion
# on Custom Event `generate_lead` (do not also set Ads IDs here — double-count).
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO=
# Meta Pixel — опційно / вторинно, лише numeric id
NEXT_PUBLIC_META_PIXEL_ID=

# ── Контакти (E-E-A-T / schema sameAs) ────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_CONTACT_GITHUB=
NEXT_PUBLIC_CONTACT_LINKEDIN=

# ── Indexing controls ─────────────────────────────────────────
# Force noindex (staging). Production Vercel preview is auto-noindex.
NEXT_PUBLIC_NOINDEX=0

# IndexNow (Bing тощо) — POST/GET /api/indexnow with Bearer token
# Vercel Cron uses CRON_SECRET automatically (vercel.json → weekly ping)
INDEXNOW_SECRET=
CRON_SECRET=
INDEXNOW_KEY=ndx-seo-7c4e9a2f1b8d4063

# ── Lead form delivery ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=

# ── DNS checklist (registrar — not env) ───────────────────────
# CAA, SPF, DKIM, DMARC — see /.well-known/security-dns.txt after deploy
